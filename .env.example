# Kurulum: `cp .env.example .env`, sonra aşağıdaki değerleri kendi key'lerinle değiştir.
# Gerçek key'leri BU dosyaya yazma; .env.example git'e girer, .env girmez.

# Google Places (New) API key'i: mekan arama.
# Google Cloud'da "Places API (New)" etkin olmalı.
PLACES_API_KEY=PLACES_API_KEY

# Google Geocoding API key'i: şehir/adres -> koordinat.
# Google Cloud'da "Geocoding API" etkin olmalı.
GEOCODING_API_KEY=GEOCODING_API_KEY

# Google Routes API key'i: duraklar arası mesafe/süre/rota çizgisi.
# Google Cloud'da "Routes API" etkin olmalı; kapalıysa plan yine döner ama
# rota çizgisi boş kalır (routes_available=false).
ROUTES_API_KEY=ROUTES_API_KEY

# Groq API key'i: plan üretimi ve serbest metin -> tema çözümleme (console.groq.com).
GROQ_API_KEY=GROQ_API_KEY

# İsteğe bağlı: kullanılacak Groq modeli (varsayılan aşağıdaki).
GROQ_MODEL=llama-3.3-70b-versatile
