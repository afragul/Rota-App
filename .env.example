# Kurulum: `cp .env.example .env`, sonra aşağıdaki değerleri kendi key'lerinle değiştir.
# Gerçek key'leri BU dosyaya yazma; .env.example git'e girer, .env girmez.

# Google Places (New) API key'i: mekan arama.
# Google Cloud'da "Places API (New)" etkin olmalı.
PLACES_API_KEY=PLACES_API_KEY

# Google Geocoding API key'i: şehir/adres -> koordinat.
# Google Cloud'da "Geocoding API" etkin olmalı.
GEOCODING_API_KEY=GEOCODING_API_KEY

# Google Routes API key'i: duraklar arası mesafe/süre/rota çizgisi.
# Google Cloud'da "Routes API" etkin olmalı; kapalıysa plan yine döner ama
# rota çizgisi boş kalır (routes_available=false).
ROUTES_API_KEY=ROUTES_API_KEY

# Groq API key'i: plan üretimi ve serbest metin -> tema çözümleme (console.groq.com).
GROQ_API_KEY=GROQ_API_KEY

# İsteğe bağlı: kullanılacak Groq modeli (varsayılan aşağıdaki).
# Not: hangi modellerin key'inle kullanılabilir olduğu hesap/tier'a göre değişir
# (ör. Llama 3.x modelleri Enterprise tier gerektirebilir). Kendi erişimini
# https://console.groq.com/docs/models veya /openai/v1/models ile doğrula.
GROQ_MODEL=openai/gpt-oss-120b

# Erişim token'larını (JWT) imzalamak için gizli anahtar; ZORUNLU, en az 32
# karakter. Üretmek için: openssl rand -hex 32
# Sızarsa herkes istediği kullanıcı adına token üretebilir; prod'da ayrı bir değer kullan.
JWT_SECRET=JWT_SECRET

# İsteğe bağlı: erişim token'ının ömrü (dakika, varsayılan 15). Kısa tutulur;
# oturumu uzun ömürlü refresh token (httpOnly cookie) sürdürür.
# JWT_EXPIRE_MINUTES=15

# Refresh token ömrü (gün, varsayılan 30).
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh cookie'si yalnızca HTTPS'te gönderilir (varsayılan true). Yerel http
# geliştirmede false yap; yayında DEĞİŞTİRME.
COOKIE_SECURE=false

# Refresh cookie'sinin yolu, tarayıcının gördüğü API adresiyle eşleşmeli
# (varsayılan /api/auth: frontend API'ye /api önekiyle gidiyor). Önek değişirse
# burası da değişmeli, yoksa cookie hiç gönderilmez ve oturum yenilenemez.
# REFRESH_COOKIE_PATH=/api/auth

# İsteğe bağlı: şifre sıfırlama e-postaları için SMTP (Gmail uygulama şifresi, Resend,
# SendGrid, Mailgun... herhangi bir sağlayıcının SMTP bilgileri). SMTP_HOST ve SMTP_FROM
# yoksa özellik KAPALI: /auth/forgot 503 verir ve arayüz "şifremi unuttum" bağlantısını
# göstermez. Şifreyi bu dosyaya yaz, git'e girmez (.env).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Bugünlük <no-reply@example.com>
# "starttls" (587, varsayılan), "ssl" (465) ya da "none" (yalnızca yerel test sunucusu)
# SMTP_SECURITY=starttls
# E-postadaki bağlantının başlayacağı adres (frontend'in gerçek adresi)
# FRONTEND_BASE_URL=http://localhost:5173

# İsteğe bağlı: prod'da frontend'in gerçek adresi (virgülle ayrılmış birden
# fazla origin olabilir). Varsayılan yalnızca yerel dev'i kapsar.
# CORS_ORIGINS=https://example.com

# İsteğe bağlı: log seviyesi ve biçimi. Canlıda json önerilir (satır başına bir JSON).
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# İsteğe bağlı: DEBUG=true yaparsan /docs, /redoc, /openapi.json açılır
# (yayında varsayılan false kalmalı).
# DEBUG=true

# Postgres (docker-compose.yml bu değerleri okur). Şifreyi güçlü bir değerle
# değiştir; kullanıcı/db adı opsiyonel (varsayılan: rota).
POSTGRES_PASSWORD=degistir-beni
# POSTGRES_USER=rota
# POSTGRES_DB=rota

# Backend'i konteynerin DIŞINDA (fastapi dev) çalıştırırken DB adresi.
# Konteynerde compose bunu kendisi ayarlar.
# DATABASE_URL=postgresql+asyncpg://rota:degistir-beni@localhost:5433/rota
