# Kurulum: `cp .env.example .env`, sonra aşağıdaki değerleri Supabase proje
# ayarlarından (Project Settings → API) kendi key'lerinle değiştir.
# Gerçek key'leri BU dosyaya yazma; .env.example git'e girer, .env girmez.

# Supabase proje URL'i (örn. https://xxxxx.supabase.co)
VITE_SUPABASE_URL=VITE_SUPABASE_URL

# Supabase anon/public key. İstemci tarafında kullanılmak üzere tasarlanmıştır
# (Row Level Security ile korunur), service_role key'i BURAYA KOYMA.
VITE_SUPABASE_ANON_KEY=VITE_SUPABASE_ANON_KEY
